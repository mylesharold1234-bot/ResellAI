# Server-only. Copy this file to .env.local and insert your own OpenAI API key.
OPENAI_API_KEY=
# Optional: a model supporting image input and strict structured output.
OPENAI_VISION_MODEL=gpt-4.1-mini

# eBay Browse API. Use the App ID and Cert ID from the SAME environment keyset.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# sandbox data is NEVER treated as live market evidence.
EBAY_ENVIRONMENT=sandbox
# Set true only after eBay approves this production use case.
EBAY_PRODUCTION_APPROVED=false

# API.SH Mercari US search (server only)
APISH_API_KEY=

# Optional: allow one additional targeted Mercari alias query when evidence is weak.
# Costs up to 2 API.SH credits per uncached search; default is 1.
MERCARI_MAX_SEARCH_QUERIES=1

# eBay seller publishing (see docs/LISTING-GENERATOR.md). Separate from the Browse API settings above,
# so price comparisons can stay on production data while publishing is tested in Sandbox.
# Publishing uses production ONLY if this is exactly "production"; anything else means Sandbox.
EBAY_SELLER_ENVIRONMENT=sandbox
# Sandbox keyset (App ID / Cert ID). If blank, EBAY_CLIENT_ID / EBAY_CLIENT_SECRET are used.
EBAY_SELLER_CLIENT_ID=
EBAY_SELLER_CLIENT_SECRET=
# RuName from the Developer Portal (User Tokens). Its accept URL must be <https tunnel>/api/ebay/seller/callback
# and its declined URL <https tunnel>/api/ebay/seller/declined.
EBAY_SELLER_RUNAME=
# 32 random bytes (hex or base64) used to encrypt seller tokens at rest.
EBAY_SELLER_TOKEN_KEY=
# true allows ResellAI to upload photos, create policies/locations and publish listings on eBay.
EBAY_SELLER_PUBLISHING_ENABLED=false
# Where you open ResellAI in the browser. eBay's callback (via the tunnel) is forwarded back here.
RESELLAI_APP_URL=http://localhost:3001

# Optional eBay request budget per item search (Browse API is free within eBay's daily call allowance).
# Pages of 200 read for a confirmed sneaker style code (1-2), multi-size listings and listing details
# checked per search (0-20), and all eBay requests from this server per hour (20-1000).
# EBAY_STYLE_CODE_PAGES=2
# EBAY_VARIATION_CHECKS=10
# EBAY_DETAIL_CHECKS=10
# EBAY_HOURLY_REQUEST_LIMIT=100
