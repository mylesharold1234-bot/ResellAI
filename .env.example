# Server-only. Copy this file to .env.local and insert your own OpenAI API key.
OPENAI_API_KEY=
# Optional: a model supporting image input and strict structured output.
OPENAI_VISION_MODEL=gpt-4.1-mini

# eBay Browse API. Use the App ID and Cert ID from the SAME environment keyset.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# sandbox data is NEVER treated as live market evidence.
EBAY_ENVIRONMENT=sandbox
# Set true only after eBay approves this production use case.
EBAY_PRODUCTION_APPROVED=false

# Facebook Marketplace through Social Fetch. Server-side only.
SOCIAL_FETCH_API_KEY=
# Keep disabled until permitted source collection and downstream display/cache/AI use are verified.
SOCIAL_FETCH_PERMITTED_USE_CONFIRMED=false
# Non-secret reference to the reviewed agreement/permission; a flag does not grant rights.
SOCIAL_FETCH_PERMISSION_REFERENCE=

# API.SH Mercari US search (server only)
APISH_API_KEY=

# Optional: allow one additional targeted Mercari alias query when evidence is weak.
# Costs up to 2 API.SH credits per uncached search; default is 1.
MERCARI_MAX_SEARCH_QUERIES=1
